{
  "name": "roadbooknavi",
  "version": "1.39.0-beta.1",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/pcace/RoadbookNavi.git"
  },
  "homepage": "https://github.com/pcace/RoadbookNavi",
  "bugs": "https://github.com/pcace/RoadbookNavi/issues",
  "type": "module",
  "scripts": {
    "build:all": "node scripts/build-all.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "tauri": "tauri",
    "test": "vitest run",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json docs *.md .github/**/*.yml Documentation/*.md native/profiles/README.md assets/fia-symbols/source.md",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json docs *.md .github/**/*.yml Documentation/*.md native/profiles/README.md assets/fia-symbols/source.md",
    "engine:build": "node scripts/build-routing-engine.mjs",
    "desktop:build": "pnpm engine:build && tauri build",
    "android:build": "pnpm engine:build --android && node scripts/android-build.mjs",
    "android:build:debug": "pnpm engine:build --android && node scripts/android-build.mjs --debug --apk --target aarch64"
  },
  "dependencies": {
    "@chakra-ui/react": "3.34.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mapbox/vector-tile": "2.0.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-geolocation": "^2",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.3.0",
    "@turf/turf": "^7.3.0",
    "framer-motion": "12.38.0",
    "i18next": "26.0.6",
    "i18next-browser-languagedetector": "8.2.1",
    "jspdf": "^4",
    "maplibre-gl": "^5.22.0",
    "markdown-it": "15.0.1",
    "markdown-it-anchor": "9.2.0",
    "next-themes": "0.4.6",
    "pbf": "4.0.2",
    "pdfjs-dist": "5.4.296",
    "proj4": "^2.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "17.0.2",
    "react-icons": "5.6.0",
    "react-map-gl": "8.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "7.14.0",
    "react-virtualized-auto-sizer": "2.0.3",
    "react-window": "2.2.7",
    "smooth-auto-scroll": "^0.2.2",
    "svg2pdf.js": "^2.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tauri-apps/cli": "^2",
    "@types/geojson": "^7946.0.16",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
