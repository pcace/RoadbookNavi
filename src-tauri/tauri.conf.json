{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoadbookNavi",
  "version": "1.39.0-beta.4",
  "identifier": "de.roadbooknavi.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RoadbookNavi",
        "width": 1280,
        "height": 850,
        "minWidth": 360,
        "minHeight": 600,
        "userAgent": "RoadbookNavi (+https://roadbooknavi.de)"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' blob: ipc: http://ipc.localhost https: http: https://tiles.openfreemap.org; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../assets/fia-symbols/": "third-party/fia-symbols/",
      "../src/map-presets/": "third-party/map-presets/",
      "../native/brouter/resources/": "engine/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "RoadbookNavi contributors. Licensed under GNU GPL v3.0. Includes separately licensed third-party components."
  }
}
